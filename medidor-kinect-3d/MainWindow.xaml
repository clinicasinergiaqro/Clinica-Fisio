<Window x:Class="MedidorSinergia3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Medidor Sinergia 3D — Kinect" Height="760" Width="620"
        Background="#0D1626" FontFamily="Segoe UI" Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🦵 Medidor Sinergia 3D — Sentadilla (Kinect v2)"
                   Foreground="#C9A84C" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Paciente:" Foreground="#9BA3B5" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtPaciente" Width="220" Text="ZZ PRUEBA MEDIDOR" Padding="6" Margin="0,0,14,0"/>
            <TextBlock Text="Terapeuta:" Foreground="#9BA3B5" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtTerapeuta" Width="180" Text="" Padding="6"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#12203A" CornerRadius="10" Padding="6">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="cvSkel" Width="512" Height="424" Background="#0A1220"/>
            </Viewbox>
        </Border>

        <TextBlock Grid.Row="3" x:Name="txtEstado" Foreground="#E8C96A" FontSize="14"
                   FontWeight="SemiBold" TextAlignment="Center" Margin="0,8" Text="Conectando con el Kinect…"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button x:Name="btnGrabar" Content="⏺ Grabar" Width="150" Height="46" FontSize="15"
                    FontWeight="Bold" Click="btnGrabar_Click" IsEnabled="False"/>
            <Button x:Name="btnReporte" Content="📄 Ver reporte" Width="150" Height="46" FontSize="14"
                    Margin="12,0,0,0" Click="btnReporte_Click" IsEnabled="False"/>
        </StackPanel>

        <Border Grid.Row="5" x:Name="panelRes" Background="#12203A" CornerRadius="10" Padding="12" Visibility="Collapsed">
            <TextBlock x:Name="txtRes" Foreground="#C9D2E8" FontSize="13" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
